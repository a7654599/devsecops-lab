[flake8]
# E/W = style, F = bugs (pyflakes), S = security (flake8-bandit)
max-line-length = 100
exclude = .git,__pycache__,.venv
per-file-ignores =
    # false positives in tests: pytest uses assert (S101), and the test only
    # imports subprocess to build a fake result, it never runs a command (S404)
    tests/*:S101,S404
